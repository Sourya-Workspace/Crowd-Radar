# ==============================================================================
# CrowdWise AI — Environment Variables & API Configuration
# ==============================================================================
# IMPORTANT: Never commit actual secret keys to source control.
# Copy this file to '.env.local' and populate with your authorized credentials.
# The platform functions out-of-the-box in High-Fidelity Demo Mode if keys are omitted.

# ------------------------------------------------------------------------------
# 1. Google Cloud Platform (Places API New & Routes API)
# ------------------------------------------------------------------------------
# Used for:
#   - Real destination search & nearby discovery: Places API (New)
#   - Traffic-aware driving routes, travel time & distance: Routes API
#
# SETUP INSTRUCTIONS:
#   1. Visit Google Cloud Console: https://console.cloud.google.com/
#   2. Create a project and link an active Billing Account.
#   3. Enable the following APIs in "APIs & Services":
#        - "Places API (New)"
#        - "Routes API"
#   4. Create an API Key in "Credentials".
#   5. RESTRICTIONS & SECURITY:
#        - Restrict key usage to only "Places API (New)" and "Routes API".
#        - Restrict application IP addresses to your production server IPs.
#        - Never prefix this variable with NEXT_PUBLIC_ (server-side only!).
#   6. Set Quotas & Budget Alerts:
#        - Set daily request quotas under "Quotas & System Limits".
#        - Configure Google Cloud Budget Alerts at 50%, 80%, and 100% of budget.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 2. Authorized Crowd Data Connectors (Tourism Feeds & Turnstile Counters)
# ------------------------------------------------------------------------------
# Used for:
#   - Ingesting official visitor telemetry from authorized tourism boards
#   - Direct turnstile / barrier hardware telemetry at monitored shrines & parks
#
# SECURITY & COMPLIANCE:
#   - Only authorized feeds complying with privacy regulations are accepted.
#   - No unauthorized web scraping or CCTV stream processing is allowed.
#   - If unavailable, the platform automatically reports "Live crowd data unavailable"
#     or falls back to a transparently labeled diurnal mathematical estimator.
GOV_TOURISM_API_URL=https://api.tourism.gov.in/telemetry/v1
GOV_TOURISM_API_KEY=your_gov_tourism_api_key_here
VENUE_COUNTER_API_KEY=your_venue_turnstile_api_key_here

# ------------------------------------------------------------------------------
# 3. Supabase (PostgreSQL Database & Authority Auth)
# ------------------------------------------------------------------------------
# Optional: If omitted, CrowdWise AI runs seamlessly on in-memory high-fidelity storage.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 4. Weather & Ambient Conditions API (Optional)
# ------------------------------------------------------------------------------
# Used for real-time temperature and meteorological forecasts across destination cities.
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ------------------------------------------------------------------------------
# 5. LLM Travel Assistant (Optional)
# ------------------------------------------------------------------------------
# Powers intelligent narrative travel recommendations and natural language Q&A.
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 6. Runtime Mode Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEMO_MODE=true
